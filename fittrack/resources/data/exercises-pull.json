[
  {
    "id": "single-arm-cable-pulldown",
    "nameZh": "单手钢线下拉",
    "nameEn": "Single-Arm Cable Pulldown",
    "aliases": ["单臂高位下拉", "单手绳索下拉"],
    "bodyPart": "背部",
    "movement": "垂直拉",
    "equipment": ["CableMachine", "SingleHandle"],
    "loadMode": "Unilateral",
    "primaryMuscles": ["背阔肌"],
    "secondaryMuscles": ["大圆肌", "肱二头肌", "肱肌", "下斜方肌"],
    "introduction": "单侧完成的垂直拉动作，便于专注背阔肌收缩并观察两侧力量差异。相比双手下拉，它允许身体和肩胛顺着单侧轨迹自然调整。",
    "steps": [
      "将滑轮调至高位，单手握住把手，另一只手扶住器械或大腿稳定身体。",
      "坐稳或采用半跪姿，躯干保持稳定，让工作侧手臂在可控范围内向上伸展。",
      "先将肩胛向下带动，再让肘部沿身体侧前方向下拉至肋骨附近。",
      "短暂停顿后缓慢伸直手臂，保持钢线张力并完成目标次数。"
    ],
    "cautions": [
      "避免借助躯干旋转或大幅后仰拉动重量。",
      "不要耸肩；若肩前侧不适，应减轻重量并缩小无痛范围。",
      "手腕保持中立，重点用肘部向下移动而不是用手猛拽。"
    ],
    "recommendedSets": 3,
    "recommendedReps": "8-15/侧",
    "restSeconds": 75,
    "alternatives": ["neutral-grip-lat-pulldown", "lat-pulldown", "pull-up"],
    "media": [],
    "sources": [
