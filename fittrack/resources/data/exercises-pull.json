  {
    "id": "bent-over-barbell-row",
    "nameZh": "俯身杠铃划船",
    "nameEn": "Bent-Over Barbell Row",
    "aliases": ["杠铃俯身划船", "杠铃划船"],
    "bodyPart": "背部",
    "movement": "水平拉",
    "equipment": ["Barbell"],
    "loadMode": "Standard",
    "primaryMuscles": ["背阔肌", "菱形肌", "中斜方肌"],
    "secondaryMuscles": ["后三角肌", "肱二头肌", "竖脊肌", "臀大肌", "腘绳肌"],
    "introduction": "在髋铰链姿势中完成的自由重量水平拉，能同时训练背部拉力和躯干等长稳定能力，但对动作控制和后侧链耐力要求较高。",
    "steps": [
      "双脚约与髋同宽站立，握住杠铃，通过屈髋让躯干前倾并保持脊柱中立。",
      "膝盖微屈，收紧腹部，使杠铃自然垂在肩部下方。",
      "保持躯干角度基本不变，将肘部向后拉，杠铃靠近上腹部。",
      "控制杠铃下降至手臂伸展，完成一组后再以稳定姿势放回地面。"
    ],
    "cautions": [
      "避免腰背弯曲、反复起伏或用髋部猛弹重量。",
      "负重不应超过维持固定躯干角度和完整控制的能力。",
      "已有腰背伤病者应先获得专业评估，必要时改用胸托划船。"
