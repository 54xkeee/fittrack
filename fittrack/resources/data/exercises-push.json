  {
    "id": "seated-shoulder-press",
    "nameZh": "坐姿推肩",
    "nameEn": "Seated Shoulder Press",
    "aliases": ["坐姿肩推", "坐姿哑铃推举", "哑铃肩推"],
    "bodyPart": "肩部",
    "movement": "垂直推",
    "equipment": ["哑铃", "带靠背训练凳"],
    "loadMode": "DumbbellPair",
    "primaryMuscles": ["三角肌前束", "三角肌中束"],
    "secondaryMuscles": ["肱三头肌", "斜方肌", "前锯肌"],
    "introduction": "坐姿双哑铃过顶推举，以三角肌为主并训练肱三头肌。靠背可减少躯干摆动，但仍需主动稳定核心和肩胛。",
    "steps": [
      "将靠背调至接近直立，双脚踩稳，哑铃置于肩部两侧。",
      "收紧核心，前臂接近垂直，让肘部略位于身体前方。",
      "呼气将哑铃向上推至双臂接近伸直，手臂保持在肩胛平面附近。",
      "吸气并受控下放至肩部附近，在稳定位置开始下一次。"
    ],
    "cautions": [
      "避免过度反弓腰椎或用腿蹬起重量。",
      "不要强迫肘部完全向身体两侧展开。",
      "肩部疼痛或活动受限时降低负荷和幅度，并寻求专业评估。"
    ],
