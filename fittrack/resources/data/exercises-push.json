  {
    "id": "pec-deck-fly",
    "nameZh": "夹胸",
    "nameEn": "Pec Deck Fly",
    "aliases": ["蝴蝶机夹胸", "器械夹胸", "坐姿夹胸"],
    "bodyPart": "胸部",
    "movement": "肩水平内收",
    "equipment": ["蝴蝶机或夹胸机"],
    "loadMode": "Standard",
    "primaryMuscles": ["胸大肌"],
    "secondaryMuscles": ["三角肌前束", "前锯肌"],
    "introduction": "通过肩关节水平内收让两侧手臂在身前靠拢的器械孤立动作，便于持续保持胸大肌张力。",
    "steps": [
      "调整座椅，使把手或前臂垫与胸部大致同高，背部贴住靠垫。",
      "握住把手或贴紧前臂垫，肩胛骨保持稳定，肘部微屈。",
      "呼气并将双臂沿器械轨迹向身前合拢，在接近处短暂停顿。",
      "吸气并缓慢打开双臂，在胸部有可控拉伸的位置反向。"
    ],
    "cautions": [
      "不要用突然反弹的方式越过底部位置。",
      "避免耸肩、头部前伸或为了夹得更近而让肩膀向前塌。",
      "肩前侧不适时缩小打开幅度并降低负荷。"
    ],
    "recommendedSets": 3,
    "recommendedReps": "10-15次",
    "restSeconds": 75,
