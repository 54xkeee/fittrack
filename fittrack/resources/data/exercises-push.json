[
  {
    "id": "barbell-bench-press",
    "nameZh": "杠铃卧推",
    "nameEn": "Barbell Bench Press",
    "aliases": ["平板杠铃卧推", "杠铃平推"],
    "bodyPart": "胸部",
    "movement": "水平推",
    "equipment": ["杠铃", "平板凳", "深蹲架或卧推架"],
    "loadMode": "Standard",
    "primaryMuscles": ["胸大肌"],
    "secondaryMuscles": ["肱三头肌", "三角肌前束"],
    "introduction": "基础水平推举动作，可用较稳定的轨迹训练胸大肌，并让肱三头肌和三角肌前束协同发力。适合作为推日的主要复合动作。",
    "steps": [
      "仰卧于平板凳，双脚稳踩地面，眼睛位于杠铃正下方附近。",
      "肩胛骨向后下方收紧，臀部保持接触凳面，以略宽于肩的闭合握法握杠。",
      "出杠后将杠铃稳定在肩部上方，吸气并受控下放至中下胸附近。",
      "前臂尽量保持接近垂直，双脚持续蹬地，将杠铃向上推回起始位置。"
    ],
    "cautions": [
      "大重量训练应使用保护杆或安排保护者。",
      "不要让杠铃砸落或在胸口反弹。",
      "手腕保持接近中立，避免肘部过度外展和肩部前顶。"
    ],
    "recommendedSets": 4,
    "recommendedReps": "5-8次",
    "restSeconds": 150,
    "alternatives": ["incline-dumbbell-bench-press", "hammer-strength-chest-press"],
    "media": [
