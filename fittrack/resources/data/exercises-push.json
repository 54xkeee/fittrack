  {
    "id": "hammer-strength-chest-press",
    "nameZh": "悍马推胸",
    "nameEn": "Hammer Strength Chest Press",
    "aliases": ["悍马机推胸", "悍马胸推", "器械推胸"],
    "bodyPart": "胸部",
    "movement": "水平推",
    "equipment": ["悍马式推胸机"],
    "loadMode": "Standard",
    "primaryMuscles": ["胸大肌"],
    "secondaryMuscles": ["肱三头肌", "三角肌前束"],
    "introduction": "借助固定或半固定器械轨迹完成的胸部推举。这里的“悍马”指 Hammer Strength 风格推胸机；不同型号的把手、座椅和配重方式不同，应优先按器械铭牌调整。",
    "steps": [
      "调整座椅，使把手大致位于中胸高度，并选择合适负荷。",
      "背部和头部贴稳靠垫，双脚踩地，肩胛骨向后下方稳定。",
      "握紧把手并向前推，肘部随器械轨迹移动，顶端不要猛烈锁死。",
      "受控回到起始位置，在肩部舒适且配重片未完全落下的位置开始下一次。"
    ],
    "cautions": [
      "先确认座椅高度和器械旋转轴与自身关节位置匹配。",
      "不要借助抬臀、含胸或耸肩完成重量。",
      "独立运动臂机型应保持左右速度和幅度一致。"
    ],
    "recommendedSets": 3,
    "recommendedReps": "8-12次",
    "restSeconds": 90,
    "alternatives": ["barbell-bench-press", "incline-dumbbell-bench-press"],
