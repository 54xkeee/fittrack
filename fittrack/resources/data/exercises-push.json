  {
    "id": "flat-dumbbell-fly",
    "nameZh": "平板内收",
    "nameEn": "Flat Dumbbell Fly",
    "aliases": ["平板哑铃飞鸟", "仰卧哑铃飞鸟", "平板飞鸟"],
    "bodyPart": "胸部",
    "movement": "肩水平内收",
    "equipment": ["哑铃", "平板凳"],
    "loadMode": "DumbbellPair",
    "primaryMuscles": ["胸大肌"],
    "secondaryMuscles": ["三角肌前束", "肱二头肌"],
    "introduction": "在平板凳上以弧线开合双臂，主要训练胸大肌的肩水平内收功能。应使用明显轻于卧推的负荷，保持肘角稳定。",
    "steps": [
      "仰卧于平板凳，双脚踩稳，将哑铃推至胸部上方，掌心相对。",
      "肩胛骨向后下方稳定，肘部保持轻微弯曲并固定这一角度。",
      "吸气，将双臂以弧线向两侧打开，直到胸部出现可控拉伸。",
      "呼气，用胸部带动双臂沿原弧线合拢，哑铃回到胸部上方。"
    ],
    "cautions": [
      "这是飞鸟而非推举，动作过程中不要反复大幅屈伸肘部。",
      "不要让哑铃下降到肩关节无法稳定控制的深度。",
      "使用明显轻于卧推的重量，避免在顶端碰撞哑铃。"
    ],
    "recommendedSets": 3,
    "recommendedReps": "10-15次",
    "restSeconds": 75,
    "alternatives": ["pec-deck-fly", "incline-dumbbell-bench-press"],
