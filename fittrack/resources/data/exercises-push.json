  {
    "id": "incline-dumbbell-bench-press",
    "nameZh": "上斜哑铃卧推",
    "nameEn": "Incline Dumbbell Bench Press",
    "aliases": ["上斜哑铃推胸", "上斜哑铃胸推"],
    "bodyPart": "胸部",
    "movement": "上斜推",
    "equipment": ["哑铃", "可调训练凳"],
    "loadMode": "DumbbellPair",
    "primaryMuscles": ["胸大肌锁骨部"],
    "secondaryMuscles": ["三角肌前束", "肱三头肌", "胸大肌胸肋部"],
    "introduction": "在上斜凳上完成的双哑铃推举，重点训练上胸，同时允许左右手独立控制负荷。凳面角度越高，三角肌前束参与通常越多。",
    "steps": [
      "将凳面调至约30至45度，双脚踩稳，哑铃置于大腿上。",
      "借助腿部将哑铃带到肩侧，肩胛骨向后下方稳定，手腕保持中立。",
      "吸气并受控下放哑铃，使肘部位于手腕下方或略向内。",
      "呼气向上推至双臂接近伸直，保持两只哑铃轨迹对称。"
    ],
    "cautions": [
      "避免把凳面调得过高而变成以肩推为主。",
      "不要在底部强行追求超过自身肩关节舒适范围的深度。",
      "大重量时让保护者协助递接哑铃。"
    ],
    "recommendedSets": 4,
    "recommendedReps": "8-12次",
    "restSeconds": 120,
    "alternatives": ["barbell-bench-press", "hammer-strength-chest-press"],
    "media": [
