QWidget { font-family: "Microsoft YaHei UI"; font-size: 13px; color: #1f2937; }
QMainWindow { background: #f5f7fa; }
QLabel#label_title { color: #0f4c81; font-size: 22px; font-weight: 700; }
QGroupBox { background: white; border: 1px solid #dbe4ee; border-radius: 8px; margin-top: 14px; padding: 14px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; color: #0f4c81; }
QLineEdit, QDoubleSpinBox { min-height: 30px; background: white; border: 1px solid #cbd5e1; border-radius: 4px; padding: 0 8px; }
QLineEdit:focus, QDoubleSpinBox:focus { border: 1px solid #1890ff; }
QPushButton { min-height: 32px; border: 1px solid #1890ff; border-radius: 4px; padding: 0 14px; background: #1890ff; color: white; font-weight: 600; }
QPushButton:hover { background: #40a9ff; }
QPushButton:pressed { background: #096dd9; }
QPushButton#pushButton_exit, QPushButton#pushButton_return { background: white; color: #475569; border-color: #cbd5e1; }
QTableWidget { background: white; alternate-background-color: #f7fbff; border: 1px solid #dbe4ee; border-radius: 6px; gridline-color: #e8eef5; selection-background-color: #d4e8ff; selection-color: #0f3157; }
QHeaderView::section { background: #eaf4ff; color: #0f4c81; border: none; border-right: 1px solid #d6e6f5; border-bottom: 1px solid #c9deef; padding: 7px; font-weight: 700; }
QTableCornerButton::section { background: #eaf4ff; border: none; border-right: 1px solid #d6e6f5; border-bottom: 1px solid #c9deef; }
QLabel#label_rankValue { color: #1890ff; font-size: 30px; font-weight: 700; }
QLabel.scoreValue { color: #0f4c81; font-size: 22px; font-weight: 700; }
